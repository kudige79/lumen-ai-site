{
  "name": "lumen-macos-website",
  "version": "1.0.0",
  "description": "The official download site for Lumen, a local-first file renamer for macOS.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run test:pages",
    "release:gate": "node scripts/release-gate.mjs",
    "test": "node --test tests/static-site.test.mjs",
    "test:pages": "node --test tests/static-site.test.mjs",
    "lint": "node --check tests/static-site.test.mjs && node --check scripts/release-gate.mjs"
  },
  "type": "module"
}
